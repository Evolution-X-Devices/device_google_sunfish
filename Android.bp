soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
    ],
}

package {
    default_applicable_licenses: ["device_google_sunfish_license"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "device_google_sunfish_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
        "SPDX-license-identifier-MIT",
        "legacy_not_a_contribution",
        "legacy_unencumbered",
    ],
    // large-scale-change unable to identify any license_text files
}

// Two 32-bit vendor libraries (libsueznanoappclients.so and
// vendor-pixelatoms-cpp.so itself) carry a DT_NEEDED on "pixelatoms-cpp.so",
// but only the 64-bit copy is installed - /vendor/lib/pixelatoms-cpp.so does
// not exist. Alias the name onto the same-arch vendor- build, matching what
// lopro104 does in proprietary_vendor_google_sunfish fb6c4184. The 64-bit side
// needs no symlink: we install a real /vendor/lib64/pixelatoms-cpp.so.
install_symlink {
    name: "vendor_lib_pixelatoms-cpp_so",
    soc_specific: true,
    installed_location: "lib/pixelatoms-cpp.so",
    symlink_target: "/vendor/lib/vendor-pixelatoms-cpp.so",
    required: ["vendor-pixelatoms-cpp"],
}
