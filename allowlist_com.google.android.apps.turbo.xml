<config>
    <!-- Device Health Services (Adaptive Battery). vendor/gms ships
         /product/etc/sysconfig/google.xml, which grants this package only the
         weaker

             <allow-in-power-save-except-idle package="com.google.android.apps.turbo" />

         so it is still restricted once the device enters Doze idle. Grant the
         full exemption, plus an exemption from Data Saver. Both entries are
         additive to what google.xml already declares; the parser merges every
         file in sysconfig/, so google.xml does not need editing. -->
    <allow-in-power-save package="com.google.android.apps.turbo" />
    <allow-in-data-usage-save package="com.google.android.apps.turbo" />
</config>
